generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OrgMember {
  id          String   @id @default(cuid())
  pole        String
  name        String
  role        String
  description String?
  photo       String?
  linkedin    String?
  twitter     String?
  instagram   String?
  twitch      String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pole, order])
  @@map("org_members")
}

model Event {
  id             String    @id @default(cuid())
  title          String
  date           String
  location       String
  type           String
  content        String?
  link           String?
  thumbnailPhoto String?
  photos         String[]
  order          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([order])
  @@map("events")
}

model Team {
  id          String   @id @default(cuid())
  name        String
  game        String
  level       String
  record      String
  description String?
  players     Json?
  nextMatches Json?
  twitchLinks Json?
  multiopggUrl String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([game, order])
  @@map("teams")
}

model Competition {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("competitions")
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  desc      String
  link      String
  logo      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@map("partners")
}

model PublicationsSettings {
  id               String   @id
  instagramPostUrl String?
  youtubeChannelUrl String?
  youtubeVideoUrl  String?
  discordInviteUrl String?
  discordPatchNotes Json?
  featuredEventId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("publications_settings")
}

model Game {
  name      String   @id
  createdAt DateTime @default(now())

  @@map("games")
}
